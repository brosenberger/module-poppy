<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        UCP modules that serve /.well-known/ucp: module name => config flag that switches the profile on.
        Another UCP module adds its own item here from its di.xml.
    -->
    <type name="BroCode\Poppy\Model\DocumentBuilder">
        <arguments>
            <argument name="ucpProfileProviders" xsi:type="array">
                <item name="Angeo_Ucp" xsi:type="string">angeo_ucp/general/enabled</item>
            </argument>
        </arguments>
    </type>
    <!-- Admin grid Reports > Poppy > Agent Feedback -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="brocode_poppy_feedback_listing_data_source" xsi:type="string">BroCode\Poppy\Model\ResourceModel\Feedback\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="BroCode\Poppy\Model\ResourceModel\Feedback\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">brocode_poppy_feedback</argument>
            <argument name="resourceModel" xsi:type="string">BroCode\Poppy\Model\ResourceModel\Feedback</argument>
        </arguments>
    </virtualType>
</config>
