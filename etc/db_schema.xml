<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="brocode_poppy_session" resource="default" engine="innodb" comment="Poppy Sessions">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="session_hash" nullable="false" length="64" comment="sha256(client_id LF sid)"/>
        <column xsi:type="varchar" name="client_id" nullable="false" length="2048" comment="Personal Agent client_id"/>
        <column xsi:type="varchar" name="sid" nullable="false" length="256" comment="Session ID"/>
        <column xsi:type="varchar" name="user_id" nullable="false" length="255" comment="User ID"/>
        <column xsi:type="varchar" name="agent_id" nullable="true" length="255" comment="Agent ID"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="last_seen_at" nullable="false" comment="Last Seen At"/>
        <column xsi:type="timestamp" name="ended_at" nullable="true" comment="Ended At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="BROCODE_POPPY_SESSION_SESSION_HASH">
            <column name="session_hash"/>
        </constraint>
        <index referenceId="BROCODE_POPPY_SESSION_LAST_SEEN_AT" indexType="btree">
            <column name="last_seen_at"/>
        </index>
        <index referenceId="BROCODE_POPPY_SESSION_ENDED_AT" indexType="btree">
            <column name="ended_at"/>
        </index>
    </table>
</schema>
