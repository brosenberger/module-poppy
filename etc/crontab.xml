<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="brocode_poppy_cleanup_sessions" instance="BroCode\Poppy\Cron\CleanupSessions" method="execute">
            <schedule>17 3 * * *</schedule>
        </job>
        <job name="brocode_poppy_cleanup_feedback" instance="BroCode\Poppy\Cron\CleanupFeedback" method="execute">
            <schedule>27 3 * * *</schedule>
        </job>
    </group>
</config>
